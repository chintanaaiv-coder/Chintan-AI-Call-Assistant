# Copy to .env (never commit .env) or set these in your host's dashboard.
OWNER_NAME=Chintan
APP_TOKEN=make-up-a-long-random-password-here
EXOTEL_STREAM_SECRET=another-long-random-string

# AI brain: gemini (default, same key as the web mockup) | claude | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Your cloned voice + speech recognition
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

DATA_DIR=/data
